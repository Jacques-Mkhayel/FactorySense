# FactorySense environment. Committed on purpose with throwaway demo values, so the stack runs
# right after a clone. Every change-me value is public: replace them before any real use, and
# never commit real credentials here (see README "Limits").

LOG_LEVEL=INFO
# Host port for the Traefik entry point. Use e.g. 8080 if 80 is taken or Docker runs rootless.
PROXY_HTTP_PORT=80
# HTTP only redirects here. Keep 443 unless taken: the redirect targets the standard HTTPS port.
PROXY_HTTPS_PORT=443

# Plant floor
SITE_ID=plant-01
MACHINE_ID=press-01
# Simulator: normal or overheating (30 s normal, then a gradual temperature rise)
SIMULATION_SCENARIO=normal
POLL_INTERVAL_S=1
# Hours of telemetry the gateway keeps locally while the WAN is down
GATEWAY_BUFFER_RETENTION_H=72
# Retry a saved MQTT message with a fresh connection if its acknowledgement never arrives
MQTT_ACK_TIMEOUT_S=30
# Local calculations and demo overheating thresholds (not equipment safety limits)
LOCAL_WINDOW_S=60
LOCAL_TEMP_CRITICAL_C=85
LOCAL_TEMP_CLEAR_C=80

# MQTT broker: one password per client (usernames are fixed in config/mosquitto/acl)
MQTT_GATEWAY_PASSWORD=change-me-gateway
MQTT_INGESTOR_PASSWORD=change-me-ingestor
MQTT_RULES_PASSWORD=change-me-rules

# TimescaleDB (PostgreSQL + time-series extension). Retentions apply on first boot only.
POSTGRES_DB=factorysense
POSTGRES_USER=factorysense
POSTGRES_PASSWORD=change-me-postgres
TELEMETRY_RETENTION="30 days"
TELEMETRY_1H_RETENTION="365 days"


# Dashboard and API. The api connects as its own least-privilege DB role (created on first boot).
API_DB_PASSWORD=change-me-api-db
# First admin account, created on first start of the api; manage other users from the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
SESSION_TTL_H=8
